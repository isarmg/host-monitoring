{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sarmg.org/host-monitoring/config-v1.schema.json",
  "title": "Host Monitoring configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["database_url"],
  "properties": {
    "database_url": { "type": "string", "minLength": 1 },
    "telemetry_queue_capacity": { "type": "integer", "minimum": 1, "maximum": 1024, "default": 256 },
    "telemetry_batch_size": { "type": "integer", "minimum": 1, "maximum": 512, "default": 64 },
    "telemetry_flush_milliseconds": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 25 },
    "telemetry_enqueue_wait_milliseconds": { "type": "integer", "minimum": 1, "maximum": 250, "default": 10 },
    "telemetry_request_timeout_milliseconds": { "type": "integer", "minimum": 100, "maximum": 30000, "default": 10000 },
    "telemetry_shutdown_drain_milliseconds": { "type": "integer", "minimum": 100, "maximum": 60000, "default": 15000 }
  }
}
